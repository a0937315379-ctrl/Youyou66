rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /responses/{responseId} {
      // 作答者僅能新增，不可讀取、列舉、修改或刪除答案。
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && request.resource.data.keys().hasOnly(['answers','extra','createdAt','version'])
        && request.resource.data.version == 1
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == 8
        && request.resource.data.extra is string
        && request.resource.data.extra.size() <= 3000
        && request.resource.data.createdAt == request.time;
      // 替換成自己的 Firebase Authentication 使用者 UID（不是 Email）。
      allow read: if request.auth != null && request.auth.uid == 'REPLACE_WITH_ADMIN_UID';
      allow update, delete: if false;
    }
  }
}
